<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                      http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <activeProfiles>
    <activeProfile>github</activeProfile>
  </activeProfiles>

  <profiles>
    <profile>
      <id>github</id>
      <repositories>
        <repository>
          <id>central</id>
          <url>https://repo1.maven.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <repository>
          <id>soot</id>
          <name>SPG Maven Repository (fork of the soot project)</name>
          <url>https://maven.pkg.github.com/spgroup/soot/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <repository>
          <id>svfa-scala</id>
          <name>Temporary repository for the SVFA library</name>
          <url>https://maven.pkg.github.com/spgroup/svfa-scala/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <repository>
          <id>spg</id>
          <name>spgroup</name>
          <url>https://maven.pkg.github.com/spgroup/soot</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <repository>
          <id>svfa</id>
          <name>svfa repository</name>
          <url>https://maven.pkg.github.com/spgroup/svfa-scala</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>

  <servers>
    <server>
      <id>soot</id>
      <username>${env.GITHUB_USER}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
    <server>
      <id>svfa-scala</id>
      <username>${env.GITHUB_USER}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
    <server>
      <id>spg</id>
      <username>${env.GITHUB_USER}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
    <server>
      <id>svfa</id>
      <username>${env.GITHUB_USER}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
  </servers>
</settings>
