# Keep Test.java
!/workspace/Test.java

# Allow traversal into libs, but ignore everything inside it

# Allow traversal into libs, but ignore everything inside it
!/workspace/libs/
/workspace/libs/*

# Keep only the SOOT dependency
!/workspace/libs/soot-4.6.0-jar-with-dependencies.jar

